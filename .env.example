# TDX MCP Server Configuration
# Copy this file to .env and fill in your values

# Base URL for your TeamDynamix instance Web API
TDX_BASE_URL=https://yourinstance.teamdynamix.com/TDWebApi/api

# Admin authentication credentials
TDX_BEID=your-beid-here
TDX_WEB_SERVICES_KEY=your-web-services-key-here

# Application IDs
TDX_TICKETING_APP_ID=123
TDX_ASSET_APP_ID=456
TDX_KB_APP_ID=789
